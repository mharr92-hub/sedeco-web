# =====================================================
# SEDECO Web — variables de entorno
# Copiar a .env.local y completar valores reales
# =====================================================

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://sedeco.lat
NEXT_PUBLIC_SITE_NAME=SEDECO Panamá

# --- Convex ---
# Obtener al correr `npx convex dev`
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Frontend API URL del instance de Clerk (sin trailing slash).
# Sacar de Clerk dashboard → JWT Templates → plantilla "convex" → Issuer.
# También se debe declarar en el dashboard de Convex (Settings → Environment Variables).
CLERK_JWT_ISSUER_DOMAIN=

# --- Clerk (autenticación admin) ---
# https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/admin/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/admin
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/admin

# --- Resend (emails transaccionales) ---
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=SEDECO Panamá <noreply@sedeco.com.pa>
RESEND_TO_LEADS=mark@selladodeconcreto.com,leads@sedeco.com.pa

# --- WhatsApp ---
NEXT_PUBLIC_WHATSAPP_NUMBER=50765508320
NEXT_PUBLIC_PHONE_DISPLAY=+507 6550-8320
NEXT_PUBLIC_PHONE_OFFICE=+507 383-5176
NEXT_PUBLIC_EMAIL=mark@selladodeconcreto.com

# --- Tracking (opcional, para fase Ads) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# --- IA (fases siguientes) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
